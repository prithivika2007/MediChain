# Copy this file to ".env" to change settings. Every line is optional.

# "mock" = the demo (everything runs in the browser, no backend needed). Default.
# "http" = talk to a real backend through the API described in API_CONTRACT.md.
VITE_API_MODE=mock

# Where the backend is when VITE_API_MODE=http.
# "/api" (default) goes through the Vite dev server, which forwards it to VITE_PROXY_TARGET.
# You can also put a full address here, for example http://localhost:8080/api (then the backend must allow CORS).
VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=http://localhost:8080

# Mock only: fake delay in milliseconds, so loading screens are visible. 0 = instant.
VITE_MOCK_LATENCY=250

# http mode only: how often (ms) pages refresh by themselves. 0 = never.
VITE_POLL_MS=10000
